{
  "name": "hru-card",
  "version": "0.0.0",
  "description": "Home Assistant Lovelace card for heat recovery units",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "lit:analyze": "lit-analyzer src --strict --maxWarnings 0 --rules.no-unknown-tag-name off",
    "check": "npm run audit && npm run lint && npm run format:check && npm run typecheck && npm run lit:analyze && npm run test:coverage",
    "prepare": "husky",
    "audit": "npm audit --audit-level=low"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,mjs,js}": "prettier --write"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lit-analyzer": "^2.0.3",
    "prettier": "^3.9.10",
    "rollup": "^4.68.2",
    "ts-lit-plugin": "^2.0.2",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.6"
    },
    "@rollup/plugin-node-resolve": {
      "deepmerge": "4.1.2"
    }
  }
}
